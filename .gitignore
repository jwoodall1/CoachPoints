# Keep the separate React Native app local-only.
/statcardAPP/

# Dependencies and package-manager caches
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# Framework, build, deployment, and generated output
.next/
out/
build/
dist/
.vercel/
.turbo/
.cache/
.parcel-cache/

# Local environment and secrets
.env*
!.env.example
!.env*.example
*.pem

# Tests, coverage, and tool caches
coverage/
.nyc_output/
.eslintcache
playwright-report/
test-results/

# TypeScript and debug output
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local Supabase state (keep migrations and config tracked)
supabase/.temp/

# Local assistant/tool state
.qodo/
/statcard/AGENTS.md

# Operating system and editor metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json.example
