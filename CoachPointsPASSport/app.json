{
  "expo": {
    "name": "CoachPoints PASSport",
    "slug": "coachpoints-passport",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "coachpoints",
    "plugins": [
      "expo-notifications",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Scan equipment tags to register and assign institution equipment.",
          "includeNdefEntitlement": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coachpoints.passport",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.coachpoints.passport",
      "adaptiveIcon": {
        "backgroundColor": "#0b1220"
      },
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "dd8c97b9-5f1e-4978-bc1c-2d42d71af635"
      }
    },
    "owner": "jonathanwoodall",
    "newArchEnabled": false
  }
}
